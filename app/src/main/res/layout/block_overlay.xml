<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_scrim"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="32dp"
            android:paddingRight="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/overlayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_overlay_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvOverlayEyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:text="MINDFUL PAUSE"
                    android:textColor="@color/br_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivMindfulnessIcon"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_overlay_icon"
                    android:contentDescription="@string/mindfulness_icon_desc"
                    android:importantForAccessibility="no"
                    android:padding="22dp"
                    android:src="@drawable/ic_focus_pause" />

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/overlay_default_title"
                    android:textColor="@color/br_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/overlay_default_message"
                    android:textColor="@color/br_text_secondary"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/br_outline_variant" />

                <LinearLayout
                    android:id="@+id/holdSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:background="@drawable/bg_hold_container">

                        <ProgressBar
                            android:id="@+id/pbHoldProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:importantForAccessibility="no"
                            android:progressBackgroundTint="@null"
                            android:progressDrawable="@drawable/progress_hold"
                            android:progressTint="@null" />

                        <TextView
                            android:id="@+id/tvHoldButtonText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="60dp"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="Hold to continue"
                            android:textColor="@color/br_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvHoldHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:text="Release early to cancel"
                        android:textColor="@color/br_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnGoBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="14dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="@string/exit_reels"
                    android:textColor="@color/br_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
