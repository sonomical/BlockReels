<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/br_scrim_top"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top 50%: Full-bleed Hero Illustration -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivMindfulnessIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_overlay_card"
            android:clipToOutline="true"
            android:contentDescription="@string/mindfulness_icon_desc"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_mindful_pause_hero" />
    </FrameLayout>

    <!-- Bottom 50%: One Strong Message + Actions -->
    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="MINDFUL PAUSE"
                android:textColor="@color/br_mint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:lineSpacingExtra="4dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="@string/overlay_default_title"
                android:textColor="@color/br_text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:text="@string/overlay_default_message"
                android:textColor="@color/br_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnGoBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:padding="14dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/exit_reels"
            android:textColor="@color/br_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/holdSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:background="@drawable/bg_hold_container">

                <ProgressBar
                    android:id="@+id/pbHoldProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:importantForAccessibility="no"
                    android:progressBackgroundTint="@null"
                    android:progressDrawable="@drawable/progress_hold"
                    android:progressTint="@null" />

                <TextView
                    android:id="@+id/tvHoldButtonText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="Hold to continue"
                    android:textColor="@color/br_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHoldHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="Release early to cancel"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
